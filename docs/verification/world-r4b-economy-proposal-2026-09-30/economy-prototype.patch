+++ b/tests/e2e/proto-before.spec.ts
@@ -0,0 +1,88 @@
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import {
+  _electron as electron,
+  expect,
+  test,
+  type ElectronApplication,
+  type Page,
+} from "@playwright/test";
+import { createServer, type ViteDevServer } from "vite";
+import react from "@vitejs/plugin-react";
+
+/**
+ * PROTOTYP M21-VIS-R4B Economy -- materiał do oceny (nie test akceptacyjny).
+ * Zrzuty trafiają do katalogu z `FC_PROTO_OUT`.
+ */
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const mainEntry = path.resolve(__dirname, "../../apps/desktop/out/main/index.js");
+const OUT = process.env.FC_PROTO_OUT ?? path.resolve(__dirname, "../../proto-shots");
+
+async function openPage(
+  app: ElectronApplication,
+  server: ViteDevServer,
+  query: string,
+  width: number,
+  height: number,
+) {
+  const url = `${server.resolvedUrls!.local[0]}visual-tests/${query}`;
+  const [page] = await Promise.all([
+    app.waitForEvent("window"),
+    app.evaluate(
+      ({ BrowserWindow }, target) => {
+        const window = new BrowserWindow({
+          width: target.width,
+          height: target.height,
+          show: true,
+        });
+        void window.loadURL(target.url);
+      },
+      { url, width, height },
+    ),
+  ]);
+  await page.setViewportSize({ width, height });
+  return page;
+}
+
+async function atlasReady(page: Page, mode: string) {
+  await expect(page.getByTestId("world-screen")).toBeVisible();
+  await expect(page.getByTestId("living-atlas")).toHaveAttribute(
+    "data-rendered-mode",
+    mode,
+  );
+  await page.evaluate(() => document.fonts.ready);
+  await page.waitForTimeout(400);
+  await page.evaluate(
+    () =>
+      new Promise<void>((resolve) =>
+        requestAnimationFrame(() => requestAnimationFrame(() => resolve())),
+      ),
+  );
+}
+
+test("PRZED -- obecny tryb Economy (główne repo, HEAD bez zmian)", async () => {
+  test.setTimeout(300_000);
+  const server = await createServer({
+    configFile: false,
+    root: process.env.FC_MAIN_DESKTOP!,
+    plugins: [react()],
+    server: { host: "127.0.0.1", port: 0, fs: { strict: false } },
+  });
+  await server.listen();
+  const app = await electron.launch({ args: [mainEntry] });
+  try {
+    await app.firstWindow();
+    for (const [name, q, w, h] of [
+      ["before-economy-1280x800-pl.png", "world.html?mode=economy&lang=pl&select=dev_green_plain", 1280, 800],
+      ["before-economy-trade-fixture-1280x800-pl.png", "world.html?fixture=trade&mode=economy&lang=pl", 1280, 800],
+    ] as const) {
+      const page = await openPage(app, server, q, w, h);
+      await atlasReady(page, "economy");
+      await page.screenshot({ path: path.join(OUT, name) });
+      await page.close();
+    }
+  } finally {
+    await app.close();
+    await server.close();
+  }
+});
