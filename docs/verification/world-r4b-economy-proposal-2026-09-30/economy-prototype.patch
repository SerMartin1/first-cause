@@ -0,0 +1,154 @@
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import {
+  _electron as electron,
+  expect,
+  test,
+  type ElectronApplication,
+  type Page,
+} from "@playwright/test";
+import { createServer, type ViteDevServer } from "vite";
+import react from "@vitejs/plugin-react";
+
+/**
+ * PROTOTYP M21-VIS-R4B Economy -- materiał do oceny (nie test akceptacyjny).
+ * Zrzuty trafiają do katalogu z `FC_PROTO_OUT`.
+ */
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const mainEntry = path.resolve(__dirname, "../../apps/desktop/out/main/index.js");
+const OUT = process.env.FC_PROTO_OUT ?? path.resolve(__dirname, "../../proto-shots");
+
+async function openPage(
+  app: ElectronApplication,
+  server: ViteDevServer,
+  query: string,
+  width: number,
+  height: number,
+) {
+  const url = `${server.resolvedUrls!.local[0]}visual-tests/${query}`;
+  const [page] = await Promise.all([
+    app.waitForEvent("window"),
+    app.evaluate(
+      ({ BrowserWindow }, target) => {
+        const window = new BrowserWindow({
+          width: target.width,
+          height: target.height,
+          show: true,
+        });
+        void window.loadURL(target.url);
+      },
+      { url, width, height },
+    ),
+  ]);
+  await page.setViewportSize({ width, height });
+  return page;
+}
+
+async function atlasReady(page: Page, mode: string) {
+  await expect(page.getByTestId("world-screen")).toBeVisible();
+  await expect(page.getByTestId("living-atlas")).toHaveAttribute(
+    "data-rendered-mode",
+    mode,
+  );
+  await page.evaluate(() => document.fonts.ready);
+  await page.waitForTimeout(400);
+  await page.evaluate(
+    () =>
+      new Promise<void>((resolve) =>
+        requestAnimationFrame(() => requestAnimationFrame(() => resolve())),
+      ),
+  );
+}
+
+test("PROTOTYP R4B Economy -- zrzuty do oceny", async () => {
+  test.setTimeout(600_000);
+  const server = await createServer({
+    configFile: false,
+    root: path.resolve("apps/desktop"),
+    plugins: [react()],
+    server: { host: "127.0.0.1", port: 0 },
+  });
+  await server.listen();
+  const app = await electron.launch({ args: [mainEntry] });
+  const log: string[] = [];
+  try {
+    await app.firstWindow();
+    const shots: [string, string, number, number][] = [];
+    for (const econ of ["employment", "sales"] as const)
+      for (const [w, h] of [
+        [1920, 1080],
+        [1280, 800],
+      ] as const)
+        for (const lang of ["pl", "en"] as const)
+          for (const sel of [false, true]) {
+            // Wariant B tylko w PL (materiał porównawczy), pełny zestaw dla A.
+            if (econ === "sales" && lang === "en") continue;
+            const name = `econ-${econ === "employment" ? "A" : "B"}-${sel ? "selected" : "none"}-${w}x${h}-${lang}.png`;
+            const q = `world.html?fixture=economy&mode=economy&econ=${econ}&lang=${lang}${sel ? "&select=econ_b_delta" : ""}`;
+            shots.push([name, q, w, h]);
+          }
+    // Zaznaczony region z zerem / brakiem danych, zoom, słaba gospodarka (klasy absolutne).
+    shots.push([
+      "econ-A-selected-zero-1280x800-pl.png",
+      "world.html?fixture=economy&mode=economy&econ=employment&lang=pl&select=econ_g_frontier",
+      1280,
+      800,
+    ]);
+    shots.push([
+      "econ-B-selected-nodata-1280x800-pl.png",
+      "world.html?fixture=economy&mode=economy&econ=sales&lang=pl&select=econ_h_marsh",
+      1280,
+      800,
+    ]);
+    shots.push([
+      "econ-A-zoom-out-1280x800-pl.png",
+      "world.html?fixture=economy&mode=economy&econ=employment&lang=pl&zoom=0.6",
+      1280,
+      800,
+    ]);
+    shots.push([
+      "econ-A-zoom-in-selected-1920x1080-pl.png",
+      "world.html?fixture=economy&mode=economy&econ=employment&lang=pl&zoom=2&select=econ_d_emporium",
+      1920,
+      1080,
+    ]);
+    shots.push([
+      "econ-A-low-economy-1280x800-pl.png",
+      "world.html?fixture=economy-low&mode=economy&econ=employment&lang=pl&select=econ_b_delta",
+      1280,
+      800,
+    ]);
+    shots.push([
+      "econ-B-low-economy-1280x800-pl.png",
+      "world.html?fixture=economy-low&mode=economy&econ=sales&lang=pl&select=econ_b_delta",
+      1280,
+      800,
+    ]);
+    // Punkt odniesienia: obecny tryb (bez prototypu) nie jest dostępny w tym drzewie --
+    // zrzut „przed” robi się w głównym repozytorium.
+    for (const [name, q, w, h] of shots) {
+      const page = await openPage(app, server, q, w, h);
+      await atlasReady(page, "economy");
+      const classes = await page
+        .getByTestId("living-atlas")
+        .getAttribute("data-economy-classes");
+      const overflow = await page.evaluate(
+        () => document.documentElement.scrollWidth > window.innerWidth,
+      );
+      log.push(`${name}: classes=${classes} hScroll=${overflow}`);
+      await page.screenshot({ path: path.join(OUT, name) });
+      if (name.includes("-selected-") && !name.includes("zoom")) {
+        // Porównanie regionów (moduł zwijany pod Atlasem): rozwinięty i przewinięty do widoku.
+        await page.locator(".fc-world__ranking summary").click();
+        await page.locator(".fc-world__ranking").scrollIntoViewIfNeeded();
+        await page.waitForTimeout(200);
+        await page.screenshot({ path: path.join(OUT, name.replace(".png", "-ranking.png")) });
+      }
+      await page.close();
+    }
+  } finally {
+    console.log(log.join("\n"));
+    await app.close();
+    await server.close();
+  }
+});
