diff --git a/apps/desktop/src/features/world/FCEconomyPanel.tsx b/apps/desktop/src/features/world/FCEconomyPanel.tsx
new file mode 100644
index 0000000..c2584ce
--- /dev/null
+++ b/apps/desktop/src/features/world/FCEconomyPanel.tsx
@@ -0,0 +1,186 @@
+import { useTranslation } from "react-i18next";
+import type { WorldRegionView, WorldSnapshot } from "@first-cause/simulation";
+import { useWorldStore } from "./world-store.js";
+import {
+  economyClass,
+  economyFact,
+  formatEconomyFull,
+  ECONOMY_SQUARE,
+  type EconomyMetric,
+} from "./economy-mode.js";
+
+/**
+ * PROTOTYP M21-VIS-R4B Economy -- zakładka „Gospodarka” inspektora regionu.
+ * Hierarchia: Gospodarka regionu → okres → miara trybu (z klasą) → pozostałe
+ * fakty z jednostkami → produkcja według towarów (bez sumy różnych towarów).
+ * Style tabeli i pomocy: istniejące klasy panelu Handlu (`fc-trade__*`).
+ */
+export function FCEconomyPanel({
+  region,
+  snapshot,
+  format,
+}: {
+  readonly region: WorldRegionView;
+  readonly snapshot: WorldSnapshot;
+  readonly format: (value: number) => string;
+}) {
+  const { t, i18n } = useTranslation();
+  const metric = useWorldStore((s) => s.economyMetric);
+  const economy = region.economy;
+  // Ten sam okres co Handel: ostatni zakończony miesiąc (1 tick = 1 miesiąc).
+  const now = snapshot.summary.currentDate;
+  const date =
+    now.month === 1 ? { year: now.year - 1, month: 12 } : { year: now.year, month: now.month - 1 };
+  const goodName = (id: string) =>
+    t(`content.good.${id}.name`, {
+      defaultValue: t(`content.resource.${id}.name`, { defaultValue: id }),
+    });
+  const other: EconomyMetric = metric === "employment" ? "sales" : "employment";
+  const factRow = (m: EconomyMetric, primary: boolean) => {
+    const fact = economyFact(region, m);
+    return (
+      <div
+        className={`fc-economy__fact${primary ? " fc-economy__fact--primary" : ""}`}
+        data-economy-fact={m}
+        data-economy-state={fact.kind === "known" ? "known" : fact.reason}
+      >
+        <span className="fc-label">{t(`world.economy.${m}.name`)}</span>
+        <span className="fc-economy__value">
+          {primary && (
+            <FCEconomyChip cls={fact.kind === "known" ? economyClass(fact.value) : "none"} />
+          )}
+          <span className="fc-data">
+            {fact.kind === "known"
+              ? formatEconomyFull(fact.value, m, i18n.language)
+              : t("world.economy.noDataLabel")}
+          </span>
+          {fact.kind === "known" && (
+            <span className="fc-caption">{t(`world.economy.${m}.unit`)}</span>
+          )}
+        </span>
+        {fact.kind === "unavailable" && (
+          <span className="fc-caption fc-economy__reason">
+            {t(`world.economy.reason.${fact.reason}`)}
+          </span>
+        )}
+      </div>
+    );
+  };
+  return (
+    <section
+      className="fc-trade fc-economy"
+      aria-labelledby="fc-economy-title"
+      data-testid="economy-panel"
+      data-economy-region={region.regionId}
+    >
+      <header className="fc-trade__header">
+        <h3 id="fc-economy-title">{t("world.economy.title")}</h3>
+        <p data-testid="economy-period">
+          <span className="fc-label">{t("world.economy.period")}</span>{" "}
+          <span className="fc-trade__period">
+            {t("world.trade.lastMonthValue", { year: date.year, month: date.month })}
+          </span>
+        </p>
+      </header>
+      {factRow(metric, true)}
+      {factRow(other, false)}
+      <div className="fc-economy__fact" data-economy-fact="companies">
+        <span className="fc-label">{t("world.activeCompanies")}</span>
+        <span className="fc-data">{format(economy.activeCompanies)}</span>
+      </div>
+      <h4 className="fc-economy__subtitle">{t("world.economy.goodsTitle")}</h4>
+      {economy.goods.length === 0 ? (
+        <p className="fc-trade__state" data-testid="economy-no-production" role="status">
+          {t(
+            economy.activeCompanies === 0
+              ? "world.economy.noCompanies"
+              : "world.economy.noProduction",
+          )}
+        </p>
+      ) : (
+        <table className="fc-trade__table" data-testid="economy-goods">
+          <colgroup>
+            <col />
+            <col className="fc-trade__num-col" />
+            <col className="fc-trade__num-col" />
+          </colgroup>
+          <thead>
+            <tr>
+              <th scope="col">{t("world.trade.good")}</th>
+              <th scope="col" className="fc-trade__num">
+                {t("world.economy.produced")}
+              </th>
+              <th scope="col" className="fc-trade__num">
+                {t("world.economy.localPrice")}
+              </th>
+            </tr>
+          </thead>
+          <tbody>
+            {[...economy.goods]
+              .sort((a, b) => goodName(a.goodId).localeCompare(goodName(b.goodId), i18n.language))
+              .map((g) => (
+                <tr key={g.goodId} data-economy-good={g.goodId}>
+                  <th scope="row">{goodName(g.goodId)}</th>
+                  <td className="fc-data fc-trade__num">{format(g.produced)}</td>
+                  <td className="fc-data fc-trade__num">
+                    {g.localPrice === undefined ? (
+                      <span className="fc-trade__qty--unavailable">
+                        {t("world.economy.noPrice")}
+                      </span>
+                    ) : (
+                      formatEconomyFull(g.localPrice, "sales", i18n.language)
+                    )}
+                  </td>
+                </tr>
+              ))}
+          </tbody>
+        </table>
+      )}
+      <details className="fc-trade__help">
+        <summary>{t("world.economy.help.title")}</summary>
+        <ul>
+          <li>{t("world.economy.help.employment")}</li>
+          <li>{t("world.economy.help.sales")}</li>
+          <li>{t("world.economy.help.goods")}</li>
+          <li>{t("world.economy.help.notGdp")}</li>
+        </ul>
+      </details>
+    </section>
+  );
+}
+
+/** Kwadrat klasy -- ten sam znak co na Atlasie i w legendzie. */
+export function FCEconomyChip({ cls }: { readonly cls: 0 | 1 | 2 | 3 | 4 | 5 | "none" }) {
+  const side = ECONOMY_SQUARE.side[cls === "none" ? 0 : cls];
+  const box = ECONOMY_SQUARE.side[5] + 2;
+  const o = (box - side) / 2;
+  const empty = cls === "none" || cls === 0;
+  return (
+    <svg
+      className="fc-economy__chip"
+      width={box}
+      height={box}
+      viewBox={`0 0 ${box} ${box}`}
+      aria-hidden="true"
+      data-economy-chip={cls}
+    >
+      <rect
+        x={o}
+        y={o}
+        width={side}
+        height={side}
+        fill={empty ? "none" : "var(--fc-info)"}
+        fillOpacity={empty ? 0 : ECONOMY_SQUARE.alpha[cls]}
+        stroke={
+          cls === "none"
+            ? "var(--fc-text-muted)"
+            : cls === 0
+              ? "var(--fc-text-secondary)"
+              : "var(--fc-info)"
+        }
+        strokeWidth={ECONOMY_SQUARE.stroke}
+        strokeDasharray={cls === "none" ? "2.2 2.2" : undefined}
+      />
+    </svg>
+  );
+}
