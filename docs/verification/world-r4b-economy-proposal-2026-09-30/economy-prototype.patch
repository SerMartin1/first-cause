diff --git a/apps/desktop/src/features/world/economy-mode.ts b/apps/desktop/src/features/world/economy-mode.ts
new file mode 100644
index 0000000..8ea1957
--- /dev/null
+++ b/apps/desktop/src/features/world/economy-mode.ts
@@ -0,0 +1,94 @@
+import type { WorldRegionView } from "@first-cause/simulation";
+
+/**
+ * PROTOTYP M21-VIS-R4B Economy (propozycja do oceny, nie wdrożenie).
+ *
+ * Tryb Economy pokazuje JEDNĄ miarę o wspólnej jednostce (wariant A:
+ * zatrudnieni w przedsiębiorstwach, osoby; wariant B: wartość sprzedaży
+ * firm, jednostka pieniężna / miesiąc). Kodowanie = Visual Alphabet v1.1 §8
+ * „Economic Output”: kwadrat rosnący i nasycający się klasami. Klasy są
+ * STAŁE i absolutne (rzędy wielkości) -- region pierwszy w rankingu nie
+ * dostaje „pełnego” koloru tylko dlatego, że jest pierwszy.
+ */
+export type EconomyMetric = "employment" | "sales";
+export type EconomyFact =
+  | { readonly kind: "known"; readonly value: number }
+  | {
+      readonly kind: "unavailable";
+      readonly reason: "NO_COMPLETED_PERIOD" | "OUTSIDE_MARKET_MODEL" | "MISSING";
+    };
+
+export function economyFact(r: WorldRegionView, metric: EconomyMetric): EconomyFact {
+  const economy = r.economy as WorldRegionView["economy"] | undefined;
+  if (!economy) return { kind: "unavailable", reason: "MISSING" };
+  if (metric === "employment")
+    return Number.isFinite(economy.employment) && economy.employment >= 0
+      ? { kind: "known", value: economy.employment }
+      : { kind: "unavailable", reason: "MISSING" };
+  return economy.sales.status === "RECORDED"
+    ? { kind: "known", value: economy.sales.value }
+    : { kind: "unavailable", reason: economy.sales.reason };
+}
+
+/** TODO tuning: dolne granice klas 2..5 (klasa 1 = (0, 10)); te same dla obu wariantów. */
+export const ECONOMY_CLASS_BOUNDS = [10, 100, 1_000, 10_000] as const;
+export type EconomyClass = 0 | 1 | 2 | 3 | 4 | 5;
+export function economyClass(value: number): EconomyClass {
+  if (value <= 0) return 0;
+  let cls = 1;
+  for (const bound of ECONOMY_CLASS_BOUNDS) if (value >= bound) cls++;
+  return cls as EconomyClass;
+}
+/**
+ * TODO tuning: bok kwadratu (px ekranu, stały przy zoomie -- klasa to fakt,
+ * nie detal) i krycie wypełnienia `--fc-info` per klasa. Indeks 0 = znacznik
+ * „0” / „brak danych” (sam kontur).
+ */
+export const ECONOMY_SQUARE = {
+  side: [9, 8, 10, 12, 14, 16],
+  alpha: [0, 0.3, 0.45, 0.62, 0.8, 1],
+  stroke: 1.3,
+} as const;
+
+/** Etykiety klas legendy (od najniższej): „1–9”, „10–99”, … „10 tys.+”. */
+export function economyClassLabels(locale: string): string[] {
+  const f = (n: number) =>
+    new Intl.NumberFormat(locale, { notation: "compact", maximumFractionDigits: 0 }).format(
+      n,
+    );
+  const b = ECONOMY_CLASS_BOUNDS;
+  return [
+    `<${f(b[0])}`,
+    `${f(b[0])}–${f(b[1] - 1)}`,
+    `${f(b[1])}–${f(b[2] - 1)}`,
+    `${f(b[2])}–${f(b[3])}`,
+    `${f(b[3])}+`,
+  ];
+}
+
+/** Zwarta wartość przy regionie; ułamek osoby / grosza > 0 nigdy nie staje się „0”. */
+export function formatEconomyCompact(
+  value: number,
+  metric: EconomyMetric,
+  locale: string,
+): string {
+  if (value > 0 && value < 1) return `<${(1).toLocaleString(locale)}`;
+  return new Intl.NumberFormat(locale, {
+    notation: "compact",
+    maximumFractionDigits: metric === "sales" && value < 1_000 ? 0 : 1,
+  }).format(Math.round(value));
+}
+
+/** Pełna wartość w inspektorze (pieniądz: 2 miejsca -- MONEY_SCALE 100, ADR-001 §4). */
+export function formatEconomyFull(
+  value: number,
+  metric: EconomyMetric,
+  locale: string,
+): string {
+  if (metric === "employment" && value > 0 && value < 1)
+    return `<${(1).toLocaleString(locale)}`;
+  return new Intl.NumberFormat(locale, {
+    minimumFractionDigits: metric === "sales" ? 2 : 0,
+    maximumFractionDigits: metric === "sales" ? 2 : 0,
+  }).format(value);
+}
